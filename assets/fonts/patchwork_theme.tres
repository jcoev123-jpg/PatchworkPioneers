[gd_resource type="Theme" load_steps=4 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/PatrickHand-Regular.ttf" id="1_hand"]
[ext_resource type="FontFile" path="res://assets/fonts/LondrinaSolid-Regular.ttf" id="2_londrina"]
[ext_resource type="FontFile" path="res://assets/fonts/LondrinaSolid-Black.ttf" id="3_londrina_black"]

[resource]
default_font = ExtResource("1_hand")
PatchTitle/base_type = &"Label"
PatchTitle/fonts/font = ExtResource("3_londrina_black")
PatchHeading/base_type = &"Label"
PatchHeading/fonts/font = ExtResource("2_londrina")
PatchHeadingButton/base_type = &"Button"
PatchHeadingButton/fonts/font = ExtResource("2_londrina")
